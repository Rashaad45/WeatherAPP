<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.weatherappproject.ui.AtmosphereView
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- Top bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/placeButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_row_ripple"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/hereIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/current_location"
                            android:src="@drawable/ic_navigation"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/cityName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            tools:text="Coimbatore" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnSearch"
                        style="@style/IconButton"
                        android:contentDescription="@string/search"
                        android:src="@drawable/ic_search" />

                    <ImageButton
                        android:id="@+id/btnMore"
                        style="@style/IconButton"
                        android:contentDescription="@string/more_options"
                        android:src="@drawable/ic_more" />
                </LinearLayout>

                <!-- Hero -->
                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:id="@+id/dateLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp"
                        tools:text="Saturday, 14 November" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/temperature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-thin"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="112sp"
                            tools:text="29°" />

                        <ImageView
                            android:id="@+id/heroIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:importantForAccessibility="no"
                            tools:src="@drawable/wx_partly_day" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        tools:text="Partly cloudy" />

                    <TextView
                        android:id="@+id/hiLo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        tools:text="H 31°   L 22°   ·   Feels like 33°" />
                </LinearLayout>

                <!-- Hourly -->
                <LinearLayout
                    android:id="@+id/hourlyCard"
                    style="@style/Card"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <TextView
                        android:id="@+id/hourlySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp"
                        tools:text="Rain likely around 5 PM. High of 31° around 2 PM." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/hairline" />

                    <HorizontalScrollView
                        android:id="@+id/hourlyScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:scrollbars="none">

                        <com.example.weatherappproject.ui.HourlyChartView
                            android:id="@+id/hourlyChart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 10-day -->
                <LinearLayout
                    android:id="@+id/dailyCard"
                    style="@style/Card"
                    android:layout_marginTop="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="@string/label_10_day" />

                    <LinearLayout
                        android:id="@+id/dailyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Air quality -->
                <LinearLayout
                    android:id="@+id/aqiCard"
                    style="@style/Card"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="@string/label_air_quality" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/aqiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_primary"
                            android:textSize="30sp"
                            tools:text="72" />

                        <TextView
                            android:id="@+id/aqiCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="Moderate" />
                    </LinearLayout>

                    <com.example.weatherappproject.ui.ScaleBarView
                        android:id="@+id/aqiBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/aqiCaption"
                        style="@style/Caption"
                        android:layout_marginTop="8dp"
                        tools:text="Acceptable. PM2.5 is 22 µg/m³." />
                </LinearLayout>

                <!-- Detail tiles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileUv"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileSun"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileWind"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileFeels"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileHumidity"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileRain"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileVisibility"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tilePressure"
                        layout="@layout/tile_metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/attribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/attribution"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- First-load and error state -->
    <LinearLayout
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/stateProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/text_primary" />

        <TextView
            android:id="@+id/stateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="@string/loading" />

        <Button
            android:id="@+id/stateRetry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
